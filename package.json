{
  "name": "mastermind-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/e2e/web/tsconfig.json && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project web --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e && playwright install chromium && playwright test --pass-with-no-tests",
    "test:live": "MASTERMIND_LIVE=1 vitest run --project live",
    "coverage": "vitest run --coverage --project unit --project web --project integration",
    "smoke:install": "sh scripts/smoke-install.sh",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mastermind/core": "workspace:*",
    "@modelcontextprotocol/sdk": "~1.31.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
